generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProgramKind {
  GIVEAWAY
  SCHOLARSHIP
  DISCOUNT
  ECOSYSTEM
}

enum ScholarshipStatus {
  SUBMITTED
  AWARDED
}

model OrganizerProfile {
  id        String          @id @default(cuid())
  wallet    String          @unique
  name      String
  bio       String?
  createdAt DateTime        @default(now())
  events    EventMetadata[]
}

model EventMetadata {
  id                   String               @id @default(cuid())
  slug                 String               @unique
  organizerId          String
  organizer            OrganizerProfile     @relation(fields: [organizerId], references: [id])
  title                String
  category             String               @default("community")
  description          String
  coverUrl             String?
  startsAt             DateTime
  endsAt               DateTime
  timezone             String               @default("Asia/Ho_Chi_Minh")
  location             String
  isOnline             Boolean              @default(false)
  metadataCapacity     Int?
  registrationDeadline DateTime?
  visibility           String               @default("PUBLIC")
  eligibility          String               @default("OPEN")
  allowedSchoolDomains String[]             @default([])
  chainEventId         String?              @unique
  fujiV2EventId        String?              @unique
  chainTx              String?              @unique
  syncStatus           String               @default("PENDING")
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  registrations        RegistrationMirror[]
  tickets              TicketMirror[]
  staffAssignments     EventStaffMirror[]
}

/// Stores a wallet-bound eligibility and an opaque HMAC nullifier, never the email address.
model StudentEligibility {
  wallet               String   @id
  chainId              Int
  senderDomain         String
  emailNullifier       String?  @unique
  verificationMode     String   @default("zk")
  rebindCount          Int      @default(0)
  blueprintId          String
  policyVersion        String
  sourceChallengeHash  String   @unique
  verifiedAt           DateTime
  expiresAt            DateTime
  revokedAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([expiresAt, revokedAt])
}

model RegistrationAuthorizationAudit {
  id                String   @id @default(cuid())
  nonceHash         String   @unique
  wallet            String
  metadataEventId   String
  chainEventId      String
  chainId           Int
  verifyingContract String
  studentNullifier  String?
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  @@index([wallet, createdAt])
  @@index([metadataEventId, createdAt])
  @@index([expiresAt])
}

model EventStaffMirror {
  id             String        @id @default(cuid())
  eventId        String
  event          EventMetadata @relation(fields: [eventId], references: [id], onDelete: Cascade)
  wallet         String
  authorized     Boolean
  chainTx        String
  changedBy      String
  updatedAt      DateTime      @updatedAt
  createdAt      DateTime      @default(now())

  @@unique([eventId, wallet])
  @@index([eventId, authorized])
}

model RegistrationMirror {
  id          String        @id @default(cuid())
  eventId     String
  event       EventMetadata @relation(fields: [eventId], references: [id])
  wallet      String
  status      String
  chainTx     String?
  blockNumber BigInt?
  createdAt   DateTime      @default(now())

  @@unique([eventId, wallet])
}

model TicketMirror {
  id          String        @id @default(cuid())
  eventId     String
  event       EventMetadata @relation(fields: [eventId], references: [id])
  tokenId     String
  ownerWallet String
  mintedAt    DateTime?
  checkedInAt DateTime?
  chainTx     String?

  @@unique([eventId, tokenId])
  @@index([ownerWallet, mintedAt])
}

model TicketChainLog {
  id              String   @id @default(cuid())
  chainId         Int
  contractAddress String
  txHash          String
  logIndex        Int
  blockNumber     BigInt
  transactionIndex Int
  blockHash       String
  tokenId         String
  eventId         String
  studentWallet   String
  createdAt       DateTime @default(now())

  @@unique([chainId, contractAddress, txHash, logIndex])
  @@index([chainId, contractAddress, studentWallet, blockNumber])
  @@index([chainId, contractAddress, tokenId])
}

model ChainSyncCheckpoint {
  id              String   @id @default(cuid())
  chainId         Int
  contractAddress String
  eventName       String
  nextBlock       BigInt
  caughtUp        Boolean  @default(false)
  lastSyncedAt    DateTime?
  updatedAt       DateTime @updatedAt

  @@unique([chainId, contractAddress, eventName])
}

model CheckInAudit {
  id          String   @id @default(cuid())
  eventId     String
  tokenId     String
  staffWallet String
  outcome     String
  chainTx     String?
  createdAt   DateTime @default(now())

  @@unique([eventId, tokenId])
}

model TicketCheckInCredential {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  eventId        String
  chainEventId   String
  tokenId        String
  ownerWallet    String
  ownerSessionId String
  expiresAt      DateTime
  consumedAt     DateTime?
  consumedBy     String?
  chainTx        String?
  createdAt      DateTime  @default(now())

  @@index([ownerWallet, createdAt])
  @@index([eventId, tokenId, expiresAt])
  @@index([expiresAt, consumedAt])
}

model AuthNonce {
  id         String    @id @default(cuid())
  wallet     String
  nonceHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([wallet, expiresAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  wallet    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([wallet, expiresAt])
}

model GasDrip {
  id        String   @id @default(cuid())
  wallet    String
  txHash    String   @unique
  amountWei String
  createdAt DateTime @default(now())

  @@index([wallet, createdAt])
}

model StudentEmailChallenge {
  id          String    @id @default(cuid())
  nonceHash   String    @unique
  wallet      String
  sessionId   String
  origin      String
  chainId     Int
  purpose     String
  attempts    Int       @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([wallet, createdAt])
  @@index([sessionId, expiresAt])
  @@index([expiresAt, consumedAt])
}

model ZkEmailAttestation {
  id             String   @id @default(cuid())
  wallet         String   @unique
  domain         String
  fromDomainHash String
  publicKeyHash  String
  proofId        String
  txHash         String   @unique
  createdAt      DateTime @default(now())
}

model Poll {
  id                   String           @id @default(cuid())
  slug                 String           @unique
  title                String
  description          String
  options              String[]
  eligibility          String           @default("OPEN")
  allowedSchoolDomains String[]         @default([])
  closesAt             DateTime
  chainPollId          String?          @unique
  chainTx              String?
  createdByWallet      String
  createdAt            DateTime         @default(now())
  votes                PollVoteMirror[]
}

model PollVoteMirror {
  id              String   @id @default(cuid())
  pollId          String
  poll            Poll     @relation(fields: [pollId], references: [id])
  option          Int
  voterNullifier  String
  chainTx         String   @unique
  createdAt       DateTime @default(now())

  @@unique([pollId, voterNullifier])
}

model Program {
  id                   String                   @id @default(cuid())
  slug                 String                   @unique
  kind                 ProgramKind
  title                String
  description          String
  sponsor              String
  eligibility          String
  allowedSchoolDomains String[]                 @default([])
  cap                  Int
  closesAt             DateTime
  amountPerClaim       String                   @default("0")
  chainProgramId       String?                  @unique
  chainTx              String?
  fundingTx            String?
  approvalTx           String?
  createdByWallet      String
  createdAt            DateTime                 @default(now())
  extra                Json                     @default("{}")
  stamps               ProgramStamp[]
  applications         ScholarshipApplication[]
  discountCodes        DiscountCode[]
}

model ProgramStamp {
  id              String   @id @default(cuid())
  programId       String
  program         Program  @relation(fields: [programId], references: [id])
  nullifier       String
  chainTx         String   @unique
  recipientWallet String?
  createdAt       DateTime @default(now())

  @@unique([programId, nullifier])
}

model ScholarshipApplication {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id])
  nullifier String
  answer    String   @db.Text
  school    String
  status    ScholarshipStatus @default(SUBMITTED)
  awardTx   String?
  createdAt DateTime @default(now())

  @@unique([programId, nullifier])
}

model DiscountCode {
  id         String    @id @default(cuid())
  programId  String
  program    Program   @relation(fields: [programId], references: [id])
  nullifier  String
  codeHash   String    @unique
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([programId, nullifier])
}
