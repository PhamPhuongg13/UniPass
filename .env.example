NEXT_PUBLIC_CHAIN_ID=43113
NEXT_PUBLIC_AVALANCHE_RPC_URL=https://avalanche-fuji-c-chain-rpc.publicnode.com
# Live Fuji V2 EventManager
NEXT_PUBLIC_EVENT_MANAGER_ADDRESS=0xFC6289Cc8e4dA635138815d75D84172C17135817
# Live Fuji V2 Ticket
NEXT_PUBLIC_TICKET_ADDRESS=0x0e84c98597647C73Ac64bae8cd25e0eb8F92353f
# Optional alias; NEXT_PUBLIC_EVENT_MANAGER_ADDRESS takes precedence.
NEXT_PUBLIC_EVENT_MANAGER_V2_ADDRESS=
NEXT_PUBLIC_STUDENT_VERIFICATION_MODE=dkim
STUDENT_EMAIL_SUFFIXES=.edu.vn
STUDENT_EMAIL_DOMAINS=
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/unipass
SESSION_SECRET=replace-with-a-random-secret
APP_ORIGIN=http://localhost:3000
# Enable after configuring the issuer key for Fuji.
STUDENT_REGISTRATION_ISSUER_ENABLED=false
# Server-only values; never prefix with NEXT_PUBLIC_ or commit real values.
REGISTRATION_ISSUER_ADDRESS=
UNIPASS_REGISTRATION_ISSUER_PRIVATE_KEY=
EMAIL_NULLIFIER_SECRET=
# Fuji testnet deployer only; fund with test AVAX from a faucet.
DEPLOYER_PRIVATE_KEY=
# Use deployBlock from deployments/fuji-v2.json.
TICKET_DEPLOYMENT_BLOCK=61337033
TICKET_INDEXER_MAX_BLOCKS_PER_RUN=9000
TICKET_INDEXER_CONFIRMATIONS=3
TICKET_INDEXER_REORG_WINDOW=12
# Set only in your local environment when you explicitly want an ntfy notification.
NTFY_TOPIC=

# Privy dashboard: App ID public, App Secret server-only.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Fuji testnet only. Never use a mainnet private key.
GAS_FAUCET_PRIVATE_KEY=
GAS_DRIP_AMOUNT_AVAX=0.005
GAS_DRIP_MIN_BALANCE_AVAX=0.001
GAS_DRIP_DAILY_CAP=300

# Poll relayer (Avalanche Fuji testnet only)
POLL_RELAYER_PRIVATE_KEY=
POLL_RELAYER_ADDRESS=
NEXT_PUBLIC_POLL_ADDRESS=
# Fuji stamp programs and test-only tUSDC
NEXT_PUBLIC_PROGRAMS_ADDRESS=
NEXT_PUBLIC_TUSDC_ADDRESS=
NEXT_PUBLIC_REGISTRATION_ISSUER_ADDRESS=
# Legacy server verifier setting; the server proof route is retired.
ZKEMAIL_BLUEPRINT_SLUG=
NEXT_PUBLIC_ZKEMAIL_ADDRESS=
NEXT_PUBLIC_SP1_VERIFIER_ADDRESS=
# Browser prover blueprint for the optional on-chain passport stamp.
NEXT_PUBLIC_ZKEMAIL_BLUEPRINT_SLUG=PhamPhuongg13/UniPass_Student_Verification@v2

# UniPass L1 / Avalanche ICM (all optional until deployment).
# L1_RPC_URL, L1_BLOCKCHAIN_ID, mirror and quest addresses stay server-side.
L1_RPC_URL=
NEXT_PUBLIC_L1_NAME=UniPass L1
NEXT_PUBLIC_L1_CHAIN_ID=
L1_BLOCKCHAIN_ID=
NEXT_PUBLIC_PASSPORT_BRIDGE_ADDRESS=
L1_MIRROR_ADDRESS=
L1_QUEST_ADDRESS=
# Optional L1 explorer base URL; without it the UI shows copyable tx hashes.
NEXT_PUBLIC_L1_EXPLORER_URL=
